 "site": {
  "en": {
   "tagline": "We look to the future by analysing the footprint of the present and past",
   "intro": "The Advanced Geomatics Applications (AGA) Research Group of the Universidad Politécnica de Madrid studies our footprints through new technologies.",
   "mission": "AGA's mission is to advance the fields of Cartographic, Geodetic and Photogrammetric Engineering and Ground Engineering.",
   "sdgs": {
    "6": "Clean water and sanitation",
    "9": "Industry, innovation and infrastructure",
    "11": "Sustainable cities and communities",
    "14": "Life below water",
    "15": "Life on land"
   }
  },
  "de": {
   "tagline": "Wir blicken in die Zukunft, indem wir den Fußabdruck von Gegenwart und Vergangenheit analysieren",
   "intro": "Die Forschungsgruppe Advanced Geomatics Applications (AGA) der Universidad Politécnica de Madrid untersucht unsere Spuren mithilfe neuer Technologien.",
   "mission": "AGA hat zum Ziel, die Fachgebiete Kartographie, Geodäsie und Photogrammetrie sowie Geotechnik voranzubringen.",
   "sdgs": {
    "6": "Sauberes Wasser und Sanitäreinrichtungen",
    "9": "Industrie, Innovation und Infrastruktur",
    "11": "Nachhaltige Städte und Gemeinden",
    "14": "Leben unter Wasser",
    "15": "Leben an Land"
   }
  },
  "fr": {
   "tagline": "Nous regardons vers l'avenir en analysant l'empreinte du présent et du passé",
   "intro": "Le groupe de recherche Applications Géomatiques Avancées (AGA) de l'Universidad Politécnica de Madrid étudie nos empreintes grâce aux nouvelles technologies.",
   "mission": "AGA a pour mission de faire progresser les domaines de l'ingénierie cartographique, géodésique et photogrammétrique ainsi que de l'ingénierie du terrain.",
   "sdgs": {
    "6": "Eau propre et assainissement",
    "9": "Industrie, innovation et infrastructure",
    "11": "Villes et communautés durables",
    "14": "Vie aquatique",
    "15": "Vie terrestre"
   }
  }
 }
